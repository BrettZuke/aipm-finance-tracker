# AI proxy environment variables (OPTIONAL feature).
# Set these in the Netlify dashboard for the ai-backend site:
#   Site settings > Environment variables.
# Do NOT commit real values. This .example file is the template; the real .env is gitignored.

# Your AI provider key. This project uses Groq (free tier, fast). Get one at
# https://console.groq.com  ->  API Keys.
GROQ_API_KEY=your_groq_api_key_here

# Your Supabase project URL and anon key (same values as in config.js).
# The function uses them to verify that the caller is a signed-in user of YOUR project.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Optional: a Groq model to try first. Without it the function uses
# openai/gpt-oss-120b, then openai/gpt-oss-20b if that one's daily free quota is used up.
# AI_MODEL=openai/gpt-oss-120b
